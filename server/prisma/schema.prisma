generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  projectMembers ProjectMember[]
  roleRequests   RoleRequest[]
  pullRequests   PullRequest[]
}

model Project {
  id             String          @id @default(uuid())
  name           String
  createdAt      DateTime        @default(now())
  projectMembers ProjectMember[]
  files          File[]
  issues         Issue[]
  invitations    Invitation[]
  roleRequests   RoleRequest[]
  testCases      TestCase[]
  pullRequests   PullRequest[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  roleName  String
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model File {
  id        String   @id @default(uuid())
  name      String
  type      String
  parentId  String?
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  parent    File?    @relation("FileChildren", fields: [parentId], references: [id])
  children  File[]   @relation("FileChildren")
}

model Issue {
  id         String   @id @default(uuid())
  title      String
  status     String   @default("open")
  authorName String
  projectId  String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id])
}

model Invitation {
  id            String           @id @default(uuid())
  projectId     String
  inviterEmail  String
  inviteeEmail  String
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  project       Project          @relation(fields: [projectId], references: [id])

  @@unique([inviteeEmail, projectId])
}

model RoleRequest {
  id            String            @id @default(uuid())
  userId        String
  projectId     String
  requestedRole String
  status        RoleRequestStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id])
  project       Project           @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model TestCase {
  id             String   @id @default(uuid())
  projectId      String
  input          String
  expectedOutput String
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id])
}

enum PullRequestStatus {
  PENDING
  MERGED
  REJECTED
}

model PullRequest {
  id                 String            @id @default(uuid())
  projectId          String
  title              String
  description        String?
  status             PullRequestStatus @default(PENDING)
  branchOrCommitHash String
  authorId           String
  createdAt          DateTime          @default(now())
  
  project            Project           @relation(fields: [projectId], references: [id])
  author             User              @relation(fields: [authorId], references: [id])
}
